{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://whooing.com",
      "https://*.whooing.com"
    ]
  },
  "permissions": [
    "core:default",
    "allow-set-notification-badge",
    "allow-notify-new-message",
    "allow-open-external"
  ]
}
